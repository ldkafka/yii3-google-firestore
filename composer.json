{
    "name": "ldkafka/yii3-google-firestore",
    "type": "library",
    "description": "Google Cloud Firestore for PHP 8.4 / Yii3 over the REST API, without gRPC or the Google SDK: documents, queries with cursors, batched writes, transactions, preconditions and field transforms through any PSR-18 client",
    "keywords": [
        "google-cloud",
        "firestore",
        "database",
        "rest",
        "yii3",
        "psr-18",
        "emulator"
    ],
    "homepage": "https://github.com/ldkafka/yii3-google-firestore",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/ldkafka/yii3-google-firestore/issues",
        "source": "https://github.com/ldkafka/yii3-google-firestore"
    },
    "authors": [
        {
            "name": "ldkafka",
            "homepage": "https://github.com/ldkafka"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "httpsoft/http-message": "^1.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "yiisoft/di": "^1.2"
    },
    "suggest": {
        "symfony/http-client": "A PSR-18 client (Psr18Client), with timeouts",
        "guzzlehttp/guzzle": "A PSR-18 client; set its timeouts, it has none by default",
        "yiisoft/config": "Wires the client from params in Yii3 applications",
        "yiisoft/cache-file": "PSR-16 cache to share the access token between processes"
    },
    "autoload": {
        "psr-4": {
            "Ldkafka\\GoogleFirestore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ldkafka\\GoogleFirestore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "params": "params.php",
            "di": "di.php"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
